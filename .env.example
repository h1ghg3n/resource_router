# Required: fill these from the intended service account and existing host socket.
# id -u SERVICE_ACCOUNT
# getent group jtop | cut -d: -f3
JETROUTER_UID=
JTOP_GID=

# Match the host service exactly. The supplied image defaults to 7.2.2.
JETSON_STATS_VERSION=7.2.2

# Optional: use a distinct immutable tag and actual commit for each deployment.
# JETROUTER_IMAGE=jetson-resource-router:YOUR_RELEASE
# VCS_REF=YOUR_FULL_COMMIT_SHA
